# ---- Service Identity ----
CODEGEN_SERVICE_NAME=codegen
CODEGEN_PORT=7073

# ---- Peers ----
ANALYZER_BASE_URL=http://localhost:7071
ENDUSER_BASE_URL=http://localhost:7074

# ---- Cosmos (owns: specs, capabilities) ----
COSMOS_ENDPOINT=<your_cosmos_endpoint>
COSMOS_KEY=<your_cosmos_key>
COSMOS_DATABASE=euca

# ---- Blob (codegen-artifacts container) ----
AZURE_STORAGE_CONNECTION_STRING=<your_storage_connection_string>
CODEGEN_ARTIFACTS_CONTAINER=codegen-artifacts
