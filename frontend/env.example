# -----------------------------------------------------------------------------
# Frontend environment template (RAID multi-service).
# Copy this file to `.env` (gitignored) and adjust as needed.
# These are PUBLIC build-time values baked into the client bundle — NO secrets.
# -----------------------------------------------------------------------------

# Per-subsystem API base URLs (RAID multi-backend client).
VITE_ANALYZER_API_BASE_URL=http://localhost:7071
VITE_ADMIN_API_BASE_URL=http://localhost:7072
VITE_CODEGEN_API_BASE_URL=https://localhost:7073
VITE_ENDUSER_API_BASE_URL=http://localhost:7074

# Legacy single-base fallback (forwards to the analyzer client).
VITE_API_BASE_URL=http://localhost:7071

# -----------------------------------------------------------------------------
# Authentication.
# Leave VITE_AUTH_MODE unset (or `header`) for local stub auth (X-User-Id /
# X-User-Role / X-Tenant-Id headers). Set to `entra` to enable Microsoft Entra
# ID (MSAL) sign-in — then the values below are required.
# -----------------------------------------------------------------------------

# VITE_AUTH_MODE=entra
# VITE_ENTRA_CLIENT_ID=<your-entra-client-id>
# VITE_ENTRA_TENANT_ID=<your-entra-tenant>
# VITE_ENTRA_API_SCOPE=api://<your-entra-client-id>/access_as_user
# VITE_ENTRA_REDIRECT_URI=http://localhost:5173
# VITE_ENTRA_ROLE_CLAIM=roles
